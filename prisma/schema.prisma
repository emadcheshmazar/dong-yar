generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonType {
  MEMBER
  GUEST
}

enum ExpenseStatus {
  ACTIVE
  CANCELLED
}

enum ExpenseSplitMode {
  EQUAL
  CUSTOM
}

enum PaymentStatus {
  PAID
  UNPAID
  NETTED
}

enum NettingEntryType {
  INITIATOR_OWES
  COUNTERPARTY_OWES
}

enum ChoreType {
  COOKING
  DISHES
  SHOPPING
  CLEANING
  OTHER
}

enum ChoreStatus {
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum ChoreIntensity {
  LIGHT
  NORMAL
  HEAVY
}

enum EmailVerificationPurpose {
  USER_SIGNUP
  GROUP_SIGNUP
  PASSWORD_RESET
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  people             Person[]
  membershipRequests MembershipRequest[]
}

model EmailVerificationCode {
  id         String                   @id @default(cuid())
  email      String
  codeHash   String
  purpose    EmailVerificationPurpose
  expiresAt  DateTime
  attempts   Int                      @default(0)
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  @@index([email, purpose, consumedAt])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  joinCode  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  people             Person[]
  expenses           Expense[]
  chores             Chore[]
  membershipRequests MembershipRequest[]
  nettingSettlements NettingSettlement[]
}

model Person {
  id           String     @id @default(cuid())
  groupId      String
  userId       String?
  name         String
  username     String?
  passwordHash String?
  type         PersonType @default(MEMBER)
  isGroupAdmin Boolean    @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  group           Group                @relation(fields: [groupId], references: [id])
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  paidExpenses    Expense[]            @relation("PaidBy")
  createdExpenses Expense[]            @relation("CreatedBy")
  participations  ExpenseParticipant[] @relation("ParticipantPerson")
  markedPayments  ExpenseParticipant[] @relation("MarkedBy")
  assignedChores  Chore[]              @relation("ChoreAssignedBy")
  choreEntries    ChoreParticipant[]   @relation("ChoreParticipantPerson")
  reviewedRequests        MembershipRequest[]  @relation("ReviewedBy")
  initiatedNettings       NettingSettlement[]  @relation("NettingInitiator")
  counterpartyNettings    NettingSettlement[]  @relation("NettingCounterparty")

  @@unique([groupId, username])
  @@unique([groupId, userId])
  @@index([userId])
}

model MembershipRequest {
  id                 String                  @id @default(cuid())
  userId             String
  groupId            String
  status             MembershipRequestStatus @default(PENDING)
  requestedAt        DateTime                @default(now())
  reviewedAt         DateTime?
  reviewedByPersonId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reviewedBy Person? @relation("ReviewedBy", fields: [reviewedByPersonId], references: [id], onDelete: SetNull)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Expense {
  id                String        @id @default(cuid())
  groupId           String
  title             String
  amount            Int
  paidByPersonId    String
  createdByPersonId String
  cardNumber        String?
  paymentNote       String?
  date              DateTime
  description       String?
  status            ExpenseStatus     @default(ACTIVE)
  splitMode         ExpenseSplitMode  @default(EQUAL)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime      @updatedAt

  group        Group                @relation(fields: [groupId], references: [id])
  paidBy       Person               @relation("PaidBy", fields: [paidByPersonId], references: [id])
  createdBy    Person               @relation("CreatedBy", fields: [createdByPersonId], references: [id])
  participants ExpenseParticipant[]
}

model Chore {
  id                 String      @id @default(cuid())
  groupId            String
  type               ChoreType
  title              String
  status             ChoreStatus @default(COMPLETED)
  scheduledFor       DateTime
  completedAt        DateTime?
  note               String?
  assignedByPersonId String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  group      Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy Person?            @relation("ChoreAssignedBy", fields: [assignedByPersonId], references: [id], onDelete: SetNull)
  people     ChoreParticipant[]

  @@index([groupId, status, scheduledFor])
  @@index([assignedByPersonId])
}

model ChoreParticipant {
  id          String         @id @default(cuid())
  choreId     String
  personId    String
  intensity   ChoreIntensity @default(NORMAL)
  score       Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  chore  Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)
  person Person @relation("ChoreParticipantPerson", fields: [personId], references: [id])

  @@unique([choreId, personId])
  @@index([personId])
}

model ExpenseParticipant {
  id                    String        @id @default(cuid())
  expenseId             String
  personId              String
  shareAmount           Int?
  shareEnteredAt        DateTime?
  paymentStatus         PaymentStatus @default(UNPAID)
  nettedAmount          Int           @default(0)
  paidAt                DateTime?
  markedByPersonId      String?
  nettingSettlementId   String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  expense             Expense              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person              Person               @relation("ParticipantPerson", fields: [personId], references: [id])
  markedByPerson      Person?              @relation("MarkedBy", fields: [markedByPersonId], references: [id])
  nettingSettlement   NettingSettlement?   @relation(fields: [nettingSettlementId], references: [id], onDelete: SetNull)
  nettingItems        NettingSettlementItem[]

  @@unique([expenseId, personId])
}

model NettingSettlement {
  id                             String   @id @default(cuid())
  groupId                        String
  initiatorPersonId              String
  counterpartyPersonId           String
  nettedAmount                   Int
  initiatorDebtBefore            Int
  initiatorReceivableBefore      Int
  initiatorDebtAfter             Int
  initiatorReceivableAfter       Int
  counterpartyDebtBefore         Int
  counterpartyReceivableBefore   Int
  counterpartyDebtAfter          Int
  counterpartyReceivableAfter    Int
  createdAt                      DateTime @default(now())

  group        Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  initiator    Person                  @relation("NettingInitiator", fields: [initiatorPersonId], references: [id])
  counterparty Person                  @relation("NettingCounterparty", fields: [counterpartyPersonId], references: [id])
  items        NettingSettlementItem[]
  participants ExpenseParticipant[]

  @@index([groupId, createdAt])
  @@index([initiatorPersonId])
  @@index([counterpartyPersonId])
}

model NettingSettlementItem {
  id            String           @id @default(cuid())
  settlementId  String
  participantId String
  amount        Int
  entryType     NettingEntryType

  settlement  NettingSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  participant ExpenseParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([participantId])
}
