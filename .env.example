DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daria_dong?schema=public"
# Production Docker settings (POSTGRES_PASSWORD should be URL-safe)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="replace-with-a-long-random-password"
POSTGRES_DB="daria_dong"
POSTGRES_VOLUME_NAME="dongyar_postgres_data"
APP_MEMORY_LIMIT="384m"
POSTGRES_MEMORY_LIMIT="256m"
NODE_MAX_OLD_SPACE_SIZE="256"
SESSION_SECRET="----"
APP_SHARED_PASSWORD="----"
# APP_SHARED_PASSWORD_HASH=""
ADMIN_PASSWORD="----"
# ADMIN_PASSWORD_HASH=""
SMTP_HOST="smtp.example.com"
SMTP_PORT="---"
SMTP_SECURE="false"
SMTP_USER="no-reply@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Dong Yar <no-reply@example.com>"
USER_FALLBACK_PASSWORD="----"
